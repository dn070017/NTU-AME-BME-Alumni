---
import { and, count, desc, eq } from 'drizzle-orm';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { db, schema } from '../../db';
import { displayDate, isoDate, mediaUrl } from '../../lib/format';
import { isPostSection, POST_SECTIONS } from '../../lib/sections';

const PAGE_SIZE = 10;

const { section } = Astro.params;
if (!isPostSection(section)) return Astro.rewrite('/404');
const { type, label, eyebrow } = POST_SECTIONS[section];

const where = and(eq(schema.posts.type, type), eq(schema.posts.published, true));
const [{ total }] = await db.select({ total: count() }).from(schema.posts).where(where);
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(pages, Math.max(1, Number(Astro.url.searchParams.get('page')) || 1));

const posts = await db
  .select({
    id: schema.posts.id,
    title: schema.posts.title,
    excerpt: schema.posts.excerpt,
    coverKey: schema.posts.coverKey,
    publishedAt: schema.posts.publishedAt,
  })
  .from(schema.posts)
  .where(where)
  .orderBy(desc(schema.posts.publishedAt), desc(schema.posts.id))
  .limit(PAGE_SIZE)
  .offset((page - 1) * PAGE_SIZE);

const pageHref = (p: number) => (p === 1 ? `/${section}` : `/${section}?page=${p}`);
---
<Base title={label}>
  <PageHeader eyebrow={eyebrow} title={label} />

  <section class="container list">
    {posts.length === 0 ? (
      <p class="list__empty">目前尚無{label}。</p>
    ) : (
      <ul class="entries">
        {posts.map((p) => (
          <li>
            <a class="entry" href={`/${section}/${p.id}`}>
              <time class="entry__date" datetime={isoDate(p.publishedAt)}>{displayDate(p.publishedAt)}</time>
              <div class="entry__body">
                <h2 class="entry__title">{p.title}</h2>
                {p.excerpt && <p class="entry__excerpt">{p.excerpt}</p>}
              </div>
              {p.coverKey && (
                <img class="entry__thumb" src={mediaUrl(p.coverKey)} alt="" loading="lazy" width="200" height="140" />
              )}
            </a>
          </li>
        ))}
      </ul>
    )}

    {pages > 1 && (
      <nav class="pager" aria-label="分頁">
        {Array.from({ length: pages }, (_, i) => i + 1).map((p) => (
          <a href={pageHref(p)} aria-current={p === page ? 'page' : undefined}>{p}</a>
        ))}
      </nav>
    )}
  </section>
</Base>

<style>
  .list {
    padding: var(--space-8) 0 var(--space-16);
  }
  .list__empty {
    padding: var(--space-12) 0;
    color: var(--c-ink-soft);
  }
  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entries li {
    border-bottom: 1px solid var(--c-line);
  }
  .entry {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: var(--space-8);
    align-items: start;
    padding: var(--space-8) 0;
    color: var(--c-ink);
    text-decoration: none;
  }
  .entry__date {
    padding-top: 0.2em;
    color: var(--c-ink-soft);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }
  .entry__title {
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: 0.06em;
    transition: color 0.2s var(--ease);
  }
  .entry__excerpt {
    display: -webkit-box;
    margin: var(--space-2) 0 0;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: var(--c-ink-soft);
    font-size: var(--fs-sm);
  }
  .entry__thumb {
    width: 160px;
    aspect-ratio: 10 / 7;
    object-fit: cover;
    border-radius: 3px;
    background: var(--c-surface);
    transition: opacity 0.3s var(--ease);
  }
  .entry:hover .entry__title {
    color: var(--c-slate-ink);
  }
  .entry:hover .entry__thumb {
    opacity: 0.85;
  }

  .pager {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-12);
  }
  .pager a {
    display: grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    color: var(--c-ink);
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .pager a[aria-current='page'] {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-bg);
  }

  @media (max-width: 720px) {
    .entry {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-4);
      padding: var(--space-6) 0;
    }
    .entry__date {
      grid-column: 1 / -1;
      padding: 0;
    }
    .entry__title {
      font-size: var(--fs-md);
    }
    .entry__thumb {
      width: 88px;
    }
  }
</style>
