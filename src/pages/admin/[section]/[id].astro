---
import { and, eq, inArray } from 'drizzle-orm';
import Admin from '../../../layouts/Admin.astro';
import PostEditor from '../../../components/admin/PostEditor';
import { db, schema } from '../../../db';
import { parseId } from '../../../lib/api';
import { isoDate } from '../../../lib/format';
import { groupOptions, isPostAdminGroup, POST_ADMIN_GROUPS } from '../../../lib/sections';

const { section: group } = Astro.params;
const id = parseId(Astro.params.id);
if (!isPostAdminGroup(group) || !id) return Astro.rewrite('/404');
const { label } = POST_ADMIN_GROUPS[group];
const options = groupOptions(group);

const [row] = await db
  .select()
  .from(schema.posts)
  .where(and(eq(schema.posts.id, id), inArray(schema.posts.type, options.map((o) => o.type))))
  .limit(1);
if (!row) return Astro.rewrite('/404');

const post = {
  id: row.id,
  title: row.title,
  contentHtml: row.contentHtml,
  coverKey: row.coverKey,
  published: row.published,
  publishedAt: isoDate(row.publishedAt),
};
---
<Admin title={row.title}>
  <PostEditor client:only="react" group={group} groupLabel={label} options={options} type={row.type} post={post} />
</Admin>
