{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ntu-ame-bme-alumni",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// 舊網址暫時保留；設定 routes 後 wrangler 預設會關閉 workers.dev，需明確開啟
	"workers_dev": true,
	// 自訂網域：部署時自動建立 DNS 紀錄與憑證
	"routes": [
		{
			"pattern": "ntu-ame-bime-alumni.org",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "alumni-db",
			"database_id": "7e855e38-e2f6-484e-acc5-5891a190b739",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "alumni-media"
		}
	],
	"vars": {
		// Cloudflare Access 設定（部署時填入）
		"CF_ACCESS_TEAM_DOMAIN": "https://ancient-haze-200e.cloudflareaccess.com",
		"CF_ACCESS_AUD": "bf01a4123dc940f18400cd27f25123a8c45542ccda7610fd7ecde4beb643c7b5"
	}
}
